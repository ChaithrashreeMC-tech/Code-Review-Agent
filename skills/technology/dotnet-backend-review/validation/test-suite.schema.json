{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".NET Backend Code Review Validation Test Suite Schema",
  "type": "object",
  "required": ["$schema", "suite", "version", "description", "testCases"],
  "properties": {
    "$schema": { "type": "string" },
    "suite": { "type": "string", "const": "dotnet-backend-review" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "category", "technology", "inputFile", "targetSymbol", "expected"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "technology": { "type": "string" },
          "inputFile": { "type": "string" },
          "targetSymbol": { "type": "string" },
          "expected": {
            "type": "object",
            "required": ["findingsPresent"],
            "properties": {
              "findingsPresent": { "type": "boolean" },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ruleId", "severity", "confidence", "evidenceContains"],
                  "properties": {
                    "ruleId": { "type": "string" },
                    "severity": { "type": "string" },
                    "confidence": { "type": "string" },
                    "evidenceContains": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "safeCounterpart": {
            "type": "object",
            "required": ["targetSymbol", "expected"],
            "properties": {
              "targetSymbol": { "type": "string" },
              "expected": {
                "type": "object",
                "required": ["findingsPresent"],
                "properties": {
                  "findingsPresent": { "type": "boolean" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

