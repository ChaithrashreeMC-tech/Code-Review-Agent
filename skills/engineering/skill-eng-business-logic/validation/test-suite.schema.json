{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Business Logic Validation Test Suite Schema",
  "type": "object",
  "required": ["$schema", "suite", "version", "description", "testCases"],
  "properties": {
    "$schema": { "type": "string" },
    "suite": { "type": "string", "const": "skill-eng-business-logic" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "ruleIds", "technology", "inputFile", "targetFunction", "expected"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "ruleIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "technology": { "type": "string" },
          "inputFile": { "type": "string" },
          "targetFunction": { "type": "string" },
          "expected": {
            "type": "object",
            "required": ["findingsPresent"],
            "properties": {
              "findingsPresent": { "type": "boolean" },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ruleId", "severity", "confidence", "evidenceContains", "scoreImpact"],
                  "properties": {
                    "ruleId": { "type": "string" },
                    "severity": { "type": "string" },
                    "confidence": { "type": "string" },
                    "evidenceContains": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "scoreImpact": { "type": "number" }
                  }
                }
              },
              "uncertaintyPresent": { "type": "boolean" },
              "uncertaintyContains": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "safeCounterpart": {
            "type": "object",
            "required": ["targetFunction", "expected"],
            "properties": {
              "targetFunction": { "type": "string" },
              "expected": {
                "type": "object",
                "required": ["findingsPresent"],
                "properties": {
                  "findingsPresent": { "type": "boolean" },
                  "notes": { "type": "string" }
                }
              }
            }
          },
          "notApplicableCase": {
            "type": "object",
            "required": ["targetFunction", "expected"],
            "properties": {
              "targetFunction": { "type": "string" },
              "expected": {
                "type": "object",
                "required": ["findingsPresent"],
                "properties": {
                  "findingsPresent": { "type": "boolean" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}

