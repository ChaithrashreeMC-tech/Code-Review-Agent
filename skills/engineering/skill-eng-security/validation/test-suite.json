{
  "$schema": "./test-suite.schema.json",
  "suite": "skill-eng-security",
  "version": "1.0.0",
  "description": "Validation test suite for all 12 security rules (SEC01–SEC12). Covers vulnerability detection, safe implementations, and false-positive protection across dedicated test files.",
  "testCases": [
    {
      "id": "TC-001",
      "description": "SQL injection via unsanitized user string concatenation.",
      "ruleIds": ["SEC01"],
      "technology": "Python/SQLite",
      "inputFile": "validation/test-data/TC-001-injection.py",
      "targetFunction": "handle_search_users_violation",
      "expected": {
        "findingsPresent": true,
        "findings": [
          {
            "ruleId": "SEC01",
            "severity": "critical",
            "confidence": "high",
            "evidenceContains": ["SELECT", "sqlite3"],
            "scoreImpact": -1.5
          }
        ]
      },
      "safeCounterpart": {
        "targetFunction": "handle_search_users_safe",
        "expected": {
          "findingsPresent": false,
          "notes": "Uses parameterized query string binding."
        }
      }
    },
    {
      "id": "TC-002",
      "description": "Hardcoded secret API key in class constructor.",
      "ruleIds": ["SEC02"],
      "technology": "Python",
      "inputFile": "validation/test-data/TC-002-hardcoded-secret.py",
      "targetFunction": "StripeServiceViolation",
      "expected": {
        "findingsPresent": true,
        "findings": [
          {
            "ruleId": "SEC02",
            "severity": "critical",
            "confidence": "high",
            "evidenceContains": ["sk_live", "Hardcoded"],
            "scoreImpact": -1.5
          }
        ]
      },
      "safeCounterpart": {
        "targetFunction": "StripeServiceSafe",
        "expected": {
          "findingsPresent": false,
          "notes": "Loads secret from environment variable."
        }
