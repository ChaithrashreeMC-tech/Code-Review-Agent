  "testCases": [

    {
      "id": "TC-001",
      "description": "N+1 query pattern: loop over orders issuing one SELECT per item via SQLAlchemy lazy loading. Unbounded collection, user-facing endpoint.",
      "ruleIds": ["PERF02"],
      "technology": "Python/SQLAlchemy",
      "inputFile": "validation/test-data/TC-001-n-plus-one.py",
      "targetFunction": "get_orders_with_items",
      "expected": {
        "findingsPresent": true,
        "findings": [
          {
            "ruleId": "PERF02",
            "severity": "high",
            "confidence": "high",
            "evidenceContains": ["loop", "items", "lazy"],
            "scoreImpact": -15
          }
        ]
      },
      "safeCounterpart": {
        "targetFunction": "get_orders_with_items_safe",
        "expected": {
          "findingsPresent": false,
          "notes": "selectinload() eager-loads items in 2 queries; no N+1 pattern."
        }
      }
    },

    {
      "id": "TC-002",
      "description": "Blocking synchronous I/O inside async function: requests.get() and time.sleep() in async handlers. Both block the event loop.",
      "ruleIds": ["PERF01"],
      "technology": "Python/asyncio",
      "inputFile": "validation/test-data/TC-002-blocking-io.py",
      "targetFunction": "fetch_user_profile_blocking",
      "expected": {
        "findingsPresent": true,
        "findings": [
          {
            "ruleId": "PERF01",
            "severity": "high",
            "confidence": "high",
            "evidenceContains": ["requests.get", "async", "blocking"],
            "scoreImpact": -15
          }
        ]
      },
      "safeCounterpart": {
        "targetFunction": "fetch_user_profile_safe",
        "expected": {
          "findingsPresent": false,
          "notes": "httpx.AsyncClient with await — non-blocking."
        }
      },
      "notApplicableCase": {
        "targetFunction": "cli_export_report",
        "expected": {
          "findingsPresent": false,
          "notes": "CLI script — blocking I/O outside async context is acceptable. PERF01 must not fire."
        }
      }
    },

